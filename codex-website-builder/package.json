{
  "name": "codex-website-builder",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "node dist/server/index.js --preview",
    "build": "tsc --noEmit && vite build && tsup && node scripts/copy-vendor.mjs",
    "start": "node dist/server/index.js",
    "test": "node scripts/smoke.mjs",
    "test:visual": "node scripts/visual.mjs",
    "prepare:plugin": "pnpm build && pnpm test:skills && pnpm test:sdk-bootstrap && pnpm test && pnpm test:projects && pnpm test:proxy && pnpm test:commerce && pnpm test:templates && pnpm test:features && pnpm test:large-preview && pnpm test:ui && pnpm test:cdn && pnpm test:imports && pnpm test:output && pnpm test:startup && pnpm test:persistence && pnpm test:management && pnpm test:global-entry && pnpm test:preview-assets && pnpm test:canvas-copy && pnpm test:open-directory",
    "install:plugin": "powershell -NoProfile -File scripts/install-plugin.ps1",
    "test:projects": "node scripts/projects.test.mjs",
    "test:proxy": "node scripts/proxy.test.mjs",
    "test:commerce": "node scripts/commerce.test.mjs",
    "test:templates": "node scripts/templates.test.mjs",
    "test:docs": "node scripts/docs.test.mjs",
    "test:features": "node scripts/features.test.mjs",
    "test:large-preview": "node scripts/large-preview.test.mjs",
    "test:ui": "node scripts/ui.test.mjs",
    "test:cdn": "node scripts/cdn.test.mjs",
    "test:imports": "node scripts/import-products.test.mjs",
    "test:output": "node scripts/output.test.mjs",
    "test:startup": "node scripts/startup.test.mjs",
    "test:persistence": "node scripts/persistence.test.mjs",
    "test:preview-assets": "node scripts/preview-assets.test.mjs",
    "test:management": "node scripts/management.test.mjs",
    "test:global-entry": "node scripts/management.test.mjs --global-entry",
    "test:canvas-copy": "node scripts/canvas-copy.test.mjs",
    "test:open-directory": "node scripts/open-directory.test.mjs",
    "test:skills": "node scripts/skills.test.mjs",
    "test:sdk-bootstrap": "node scripts/sdk-bootstrap.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "acorn": "8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
