{
  "name": "storybook2-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "storybook": "npm run build:library && storybook dev -p 6008 --host 127.0.0.1 --no-open",
    "build:library": "vite build --config vite.library.config.js && npm run build:examples && npm run build:playground",
    "build:examples": "node scripts/build-examples.mjs",
    "build:playground": "vite build --config vite.playground.config.js",
    "playground:dev": "vite --config vite.playground.config.js --host 127.0.0.1 --port 6011 --strictPort",
    "preview:dev": "vite --host 127.0.0.1 --port 6009 --strictPort",
    "build": "npm run build:library && storybook build && vite build",
    "build-storybook": "npm run build",
    "serve": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6010 --strictPort",
    "verify": "node scripts/verify.mjs",
    "preverify": "npm run build:examples",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "acorn": "8.14.0",
    "@playwright/test": "1.51.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/web-components": "8.6.14",
    "@storybook/web-components-vite": "8.6.14",
    "lit": "3.2.1",
    "storybook": "8.6.14",
    "vite": "6.1.0"
  }
}
