{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "website-builder": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/server/index.js"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "WEBSITE_BUILDER_ROOT": "Q:/Projects/DEMO/codex-website-development/website",
        "WEBSITE_BUILDER_PROJECT_ROOT": "Q:/Projects/DEMO/codex-website-development/codex-website-builder/project",
        "WEBSITE_BUILDER_SKILL_ROOT": "${PLUGIN_ROOT}/skills/website-builder"
      }
    }
  }
}
