{
  "name": "starlight-docs",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "docs:generate": "node ../storybook2/scripts/build-examples.mjs && node scripts/generate-docs.mjs",
    "dev": "npm run docs:generate && astro dev --port 4321",
    "build": "npm run docs:generate && astro build",
    "preview": "astro preview --port 4321"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.32.0",
    "acorn": "8.19.0",
    "astro": "^5.4.2",
    "parse5": "7.3.0",
    "starlight-llms-txt": "^0.12.0"
  }
}
