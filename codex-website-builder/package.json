{
  "name": "codex-website-builder",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "node dist/server/index.js --preview",
    "build": "tsc --noEmit && vite build && tsup && node scripts/copy-vendor.mjs",
    "start": "node dist/server/index.js",
    "test": "node scripts/smoke.mjs",
    "test:visual": "node scripts/visual.mjs",
    "prepare:plugin": "pnpm build && pnpm test && pnpm test:projects && pnpm test:proxy && pnpm test:commerce && pnpm test:templates",
    "install:plugin": "powershell -NoProfile -File scripts/install-plugin.ps1",
    "test:projects": "node scripts/projects.test.mjs",
    "test:proxy": "node scripts/proxy.test.mjs",
    "test:commerce": "node scripts/commerce.test.mjs",
    "test:templates": "node scripts/templates.test.mjs",
    "test:docs": "node scripts/docs.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "acorn": "8.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
